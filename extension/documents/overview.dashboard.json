{
  "tiles": {
    "0": {
      "content": "## Red Hat Identity Management Health Overview",
      "type": "markdown"
    },
    "1": {
      "davis": {
        "davisVisualization": {
          "isAvailable": true
        }
      },
      "query": "timeseries value = avg(custom.freeipa.idm.service.status), by: {service.name} | fieldsAdd status = if(arrayLast(value) == 1, \"UP\", else: \"DOWN\") | fields service.name, status",
      "queryConfig": {
        "subQueries": [],
        "version": 20
      },
      "querySettings": {
        "defaultSamplingRatio": 10,
        "defaultScanLimitGbytes": 500,
        "enableSampling": false,
        "maxResultMegaBytes": 1,
        "maxResultRecords": 1000
      },
      "title": "Service Health",
      "type": "data",
      "visualization": "honeycomb",
      "visualizationSettings": {
        "autoSelectVisualization": false,
        "coloring": {
          "colorRules": [
            {
              "colorMode": "color-palette",
              "colorPalette": "apdex",
              "comparator": "=",
              "field": "status",
              "type": "string",
              "value": "UP"
            },
            {
              "colorMode": "color-palette",
              "colorPalette": "fireplace",
              "comparator": "=",
              "field": "status",
              "type": "string",
              "value": "DOWN"
            }
          ]
        },
        "honeycomb": {
          "dataMappings": {
            "value": "status"
          },
          "displayedFields": [
            "service.name"
          ],
          "labels": {
            "showLabels": true
          },
          "legend": {
            "hidden": true,
            "position": "right"
          },
          "max": {
            "mode": "custom",
            "value": 1
          },
          "min": {
            "mode": "custom"
          }
        }
      }
    },
